#!/bin/bash
# Renders the SVG artwork into the PNGs that KDE, SDDM, Plymouth and Calamares want, and replaces the
# default Plasma wallpaper so a fresh user sees the pond instead of a black screen.
set -euo pipefail
BR=/usr/share/quackos/branding
render() { rsvg-convert -w "$2" -h "$3" "$BR/$1.svg" -o "$4"; }


# Plymouth
P=/usr/share/plymouth/themes/quackos
render logo 192 192 "$P/logo.png"
render bar-bg 400 10 "$P/bar-bg.png"
render bar-fill 400 10 "$P/bar-fill.png"
plymouth-set-default-theme quackos

# Calamares
C=/usr/share/calamares/branding/quackos
render logo 256 256 "$C/logo.png"
render logo 256 256 "$C/welcome.png"

# Icon for launchers (theme-independent)
mkdir -p /usr/share/icons/hicolor/scalable/apps /usr/share/icons/hicolor/256x256/apps
cp "$BR/logo.svg" /usr/share/icons/hicolor/scalable/apps/quackos.svg
render logo 256 256 /usr/share/icons/hicolor/256x256/apps/quackos.png

# Plasma's default wallpaper. Plasma 6.3's look-and-feel (breeze, breezedark) asks for the wallpaper whose Id is
# "Next", and Debian ships it only in breeze-wallpaper / plasma-workspace-wallpapers (43 and 128 MB, not in the image).
# We ship our own package with that Id (static metadata.json in the image tree) and render its images here, so every
# way Plasma has of choosing the default (look-and-feel defaults, plasmarc, the built-in fallback) lands on the pond.
W=/usr/share/wallpapers/Next
[ -f "$W/metadata.json" ] || { echo "FATAL: $W/metadata.json missing from the image tree: the desktop would be black" >&2; exit 1; }
mkdir -p "$W/contents/images"
for size in 1280x800 1366x768 1920x1080 1920x1200 2560x1440 3840x2160; do
    render wallpaper "${size%x*}" "${size#*x}" "$W/contents/images/$size.png"
    [ -s "$W/contents/images/$size.png" ] || { echo "FATAL: wallpaper $size was not rendered" >&2; exit 1; }
done
# Two packages with the same Id would make Plasma pick one at random: fail if a stock wallpaper package sneaks in.
others="$(grep -l '"Id": *"Next"' /usr/share/wallpapers/*/metadata.json | grep -v "^$W/" || true)"
[ -z "$others" ] || { echo "FATAL: another wallpaper has Id Next: $others" >&2; exit 1; }

# The same pictures for SDDM and anything that wants a plain file (symlinks: no second copy in the image)
mkdir -p /usr/share/backgrounds/quackos
ln -sf "$W/contents/images/1920x1080.png" /usr/share/backgrounds/quackos/quackos.png
ln -sf "$W/contents/images/3840x2160.png" /usr/share/backgrounds/quackos/quackos-4k.png

# SDDM login screen background
T=/usr/share/sddm/themes/breeze
if [ -d "$T" ]; then
    printf '[General]\nbackground=/usr/share/backgrounds/quackos/quackos.png\ntype=image\n' > "$T/theme.conf.user"
fi
