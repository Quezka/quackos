[Unit]
Description=QuackOS debug report (only with quackos.debug on the kernel command line)
ConditionKernelCommandLine=quackos.debug
# No After=multi-user.target here: a target is implicitly ordered AFTER every unit it Wants, so After=multi-user.target
# together with WantedBy=multi-user.target is an ordering cycle, and systemd silently drops one of the jobs
# (that is why the report never appeared). Type=simple so the target does not wait for the report's sleep either.

[Service]
Type=simple
ExecStart=/usr/local/lib/quackos/debug-report
StandardOutput=tty
TTYPath=/dev/ttyS0

[Install]
WantedBy=multi-user.target
