{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "/usr/share/quackos/duck.txt", "color": { "1": "yellow", "2": "white" } },
  "display": { "separator": "  " },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS" },
    "kernel", "uptime", "packages", "shell", "de", "wm",
    { "type": "custom", "format": "🦆 DuckNet: {$QUACKOS_DUCKNET}" },
    "cpu", "memory", "disk",
    "break", "colors"
  ]
}
