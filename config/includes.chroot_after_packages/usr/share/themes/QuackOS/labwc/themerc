# QuackOS window theme for labwc: macOS-like titlebars (traffic lights on the left, set in rc.xml).
# Colours: the indigo palette of the QuackOS apps (see docs/de-design.md).
border.width: 1
window.titlebar.padding.width: 10
window.titlebar.padding.height: 6
window.button.width: 20
window.button.height: 20
window.button.spacing: 8
window.label.text.justify: Center

window.active.border.color: #2f3138
window.inactive.border.color: #26282d
window.active.title.bg.color: #2b2d33
window.inactive.title.bg.color: #232529
window.active.label.text.color: #ecedef
window.inactive.label.text.color: #7d818a
window.active.button.unpressed.image.color: #ecedef
window.inactive.button.unpressed.image.color: #7d818a

window.active.shadow.size: 48
window.inactive.shadow.size: 28
window.active.shadow.color: #00000066
window.inactive.shadow.color: #00000040

menu.items.bg.color: #1d1f23
menu.items.text.color: #ecedef
menu.items.active.bg.color: #5b5bd6
menu.items.active.text.color: #ffffff
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.border.width: 1
menu.border.color: #33363c
menu.separator.color: #33363c
menu.width.min: 180

osd.bg.color: #1d1f23e6
osd.border.color: #5b5bd6
osd.border.width: 1
osd.label.text.color: #ecedef
osd.window-switcher.item.active.border.color: #5b5bd6
