# QuackOS window theme for labwc: macOS-like light titlebars (traffic lights on the left, set in rc.xml).
border.width: 1
window.titlebar.padding.width: 10
window.titlebar.padding.height: 6
window.button.width: 20
window.button.height: 20
window.button.spacing: 8
window.label.text.justify: Center

window.active.border.color: #c9cad1
window.inactive.border.color: #dcdde2
window.active.title.bg.color: #eaeaef
window.inactive.title.bg.color: #f5f5f8
window.active.label.text.color: #2f3037
window.inactive.label.text.color: #9d9fa8
window.active.button.unpressed.image.color: #2f3037
window.inactive.button.unpressed.image.color: #9d9fa8

window.active.shadow.size: 56
window.inactive.shadow.size: 30
window.active.shadow.color: #00000070
window.inactive.shadow.color: #00000040

menu.items.bg.color: #f6f6f9
menu.items.text.color: #2b2d33
menu.items.active.bg.color: #5b5bd6
menu.items.active.text.color: #ffffff
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.border.width: 1
menu.border.color: #d3d4da
menu.separator.color: #dcdde2
menu.width.min: 180

osd.bg.color: #1d1f23e6
osd.border.color: #5b5bd6
osd.border.width: 1
osd.label.text.color: #ecedef
osd.window-switcher.item.active.border.color: #5b5bd6
