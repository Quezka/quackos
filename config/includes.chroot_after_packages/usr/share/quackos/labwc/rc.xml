<?xml version="1.0"?>
<!-- QuackOS session configuration for labwc 0.8 (the compositor). Own file, used with `labwc -C`. -->
<labwc_config>

  <core>
    <gap>6</gap>
  </core>

  <!-- Reserves space for the bar (top) and the dock (bottom) from the moment labwc starts, so a window that opens or
       maximizes before our Python shell has finished booting (it takes a second or two) is never placed under them.
       The dynamic layer-shell exclusion zone (set in main_layer.qml) does the same job once the shell is up; this is
       the static fallback for the gap before that, and for any future panel that does not speak layer-shell. -->
  <margin top="28" bottom="80" />

  <!-- Some apps do not negotiate the xdg-decoration protocol and would otherwise open with no server titlebar/border
       at all: no way to move or resize them. Force server decorations for everyone; <core><decoration> already
       defaults to "server" but a window rule overrules per-window exceptions some toolkits ask for. -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="yes" />
  </windowRules>

  <theme>
    <name>QuackOS</name>
    <!-- macOS order: close, minimise, zoom on the left; the colon is mandatory -->
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
    <font name="Inter" size="10" />
  </theme>

  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <dragLock>no</dragLock>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
  </libinput>

  <keyboard>
    <default />
    <!-- Super is the Command key -->
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-w"><action name="Close" /></keybind>
    <keybind key="W-m"><action name="Iconify" /></keybind>
    <keybind key="W-h"><action name="Iconify" /></keybind>
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow" /></keybind>
    <!-- Control+Command+F: full screen, like macOS; Command+Up zooms (maximise) -->
    <keybind key="C-W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f -c 111214" /></keybind>
    <keybind key="C-W-q"><action name="Execute" command="swaylock -f -c 111214" /></keybind>
    <!-- Screenshots (saved in ~/Pictures and copied): Print or Shift+Command+4 = an area, Shift+Command+3 = the whole screen -->
    <keybind key="Print"><action name="Execute" command="quackos-screenshot area" /></keybind>
    <keybind key="W-S-4"><action name="Execute" command="quackos-screenshot area" /></keybind>
    <keybind key="W-S-3"><action name="Execute" command="quackos-screenshot screen" /></keybind>
    <keybind key="XF86_MonBrightnessUp"><action name="Execute" command="brightnessctl set 5%+" /></keybind>
    <keybind key="XF86_MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
    <keybind key="XF86_AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86_AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86_AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- The three coloured buttons, like macOS: red closes, yellow goes to the dock, GREEN IS FULL SCREEN
         (Right click on it zooms: maximise). Double click on the title bar also zooms. -->
    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="ToggleFullscreen" /></mousebind>
      <mousebind button="Right" action="Click"><action name="ToggleMaximize" /></mousebind>
    </context>
  </mouse>

</labwc_config>
