# QuackOS splash: dark indigo gradient, the logo, and a progress bar underneath.
Window.SetBackgroundTopColor(0.08, 0.08, 0.18);
Window.SetBackgroundBottomColor(0.28, 0.28, 0.68);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

bar.bg = Image("bar-bg.png");
bar.fill = Image("bar-fill.png");
bar.x = Window.GetWidth() / 2 - bar.bg.GetWidth() / 2;
bar.y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 10;
bar.bg_sprite = Sprite(bar.bg);
bar.bg_sprite.SetPosition(bar.x, bar.y, 1);
bar.fill_sprite = Sprite();
bar.fill_sprite.SetPosition(bar.x, bar.y, 2);

fun boot_progress(time, progress) {
    width = Math.Int(bar.fill.GetWidth() * progress);
    if (width < 1) width = 1;
    bar.fill_sprite.SetImage(bar.fill.Scale(width, bar.fill.GetHeight()));
}
Plymouth.SetBootProgressFunction(boot_progress);
