# --- what live-config needs to CREATE the live user and log in ---
# live-config only *Recommends* these; with apt-recommends off they must be listed or the user `quack` is never
# created and the login says "wrong password".
user-setup
keyboard-configuration
locales
iproute2
live-tools
libpam-systemd
dbus-user-session
# --- system basics ---
ntfs-3g
sudo
polkitd
pkexec
curl
ca-certificates
git
nano
htop
fastfetch
jq
unzip
zip
xdg-user-dirs
python3
python3-venv
python3-pip
librsvg2-bin
imagemagick
# --- graphics: Mesa drivers, X server and input (Recommends of xserver-xorg-core and friends) ---
libgl1-mesa-dri
libglx-mesa0
mesa-vulkan-drivers
mesa-va-drivers
xwayland
xserver-xorg
xserver-xorg-input-libinput
# --- firmware for real hardware (Wi-Fi, GPUs, microcode) ---
firmware-linux
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-amd-graphics
intel-microcode
amd64-microcode
# --- network, bluetooth, sound ---
network-manager
wpasupplicant
wireless-regdb
systemd-timesyncd
bluez
pipewire-audio
wireplumber
# --- fonts (emoji matter: ducks are emoji) ---
fonts-noto-core
fonts-noto-color-emoji
fonts-firacode
# --- the regular web (Stagno only speaks DuckNet) ---
firefox-esr
firefox-esr-l10n-it
firefox-esr-l10n-ru
